# Copy to .env and fill in.

# Database. Local dev uses SQLite; production uses PostgreSQL:
#   DATABASE_URL="postgresql://user:pass@host:5432/airbrick?schema=public"
DATABASE_URL="file:./dev.db"

# Email notifications for new leads (Resend). Optional — leads still persist without it.
RESEND_API_KEY=""
LEAD_NOTIFY_TO="business@airbrickinfra.com"
